{
  "name": "koishi-plugin-60s-vincentzyu",
  "description": "📰 对接 60s 开放 API（https://github.com/vikiboss/60s），提供早报、热榜、天气与实用工具。🛠️",
  "version": "0.2.2-beta.3+20261007",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "templates"
  ],
  "homepage": "https://github.com/vikiboss/60s",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "60s"
  ],
  "scripts": {
    "test": "vitest run",
    "test:live-output": "node -r esbuild-register scripts/live-output.ts",
    "test:api": "node -r esbuild-register scripts/test-api.ts",
    "test:preview": "node -r esbuild-register scripts/live-output.ts --gen-preview-image --image-theme github --only daily,weather,hot-weibo,history,moyu"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.0",
    "koishi": "^4.18.7"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    },
    "koishi-plugin-puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.0",
    "@koishijs/plugin-console": "^5.30.0",
    "@types/node-cron": "^3.0.11",
    "puppeteer-core": "22.6.1",
    "vitest": "^3.2.4"
  },
  "koishi": {
    "description": {
      "en": "60s open API plugin for news, hot searches, weather, utilities, and more.",
      "zh": "60s 开放 API 插件，提供早报、热榜、天气、实用工具等常用功能。"
    },
    "service": {
      "required": [
        "http"
      ],
      "optional": [
        "puppeteer",
        "console"
      ]
    }
  },
  "dependencies": {
    "@chinese-fonts/lxgwwenkai": "^3.0.0",
    "node-cron": "^3.0.3"
  }
}
